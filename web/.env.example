# Copy to .env and fill in. Only HEVY_API_KEY and one way to log in are required.

# Hevy → Settings → Developer (Hevy Pro). Without it the app runs on demo data.
HEVY_API_KEY=

# Long random string; signs login cookies.  openssl rand -base64 32
SESSION_SECRET=

# Your timezone, for "today" and the calendar
TIMEZONE=America/New_York

# ── Login: pick ONE ──
# a) Password
APP_PASSWORD=
# b) Google sign-in (Google Cloud → Credentials → OAuth client, Web application;
#    redirect URI https://<your host>/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in with Google (comma separated)
ALLOWED_EMAILS=

# Optional: Hevy webhook (Settings › Developer › Webhooks → https://<host>/api/hevy/webhook, Bearer <this>)
WEBHOOK_SECRET=
# Optional: WHOOP (developer.whoop.com app; redirect https://<host>/api/whoop/callback)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Minutes between background syncs (0 = off)
SYNC_MINUTES=15
