<?xml version="1.0" encoding="utf-8"?>
<!--
  Credentials never leave the device. allowBackup="false" turns off cloud backup, but on Android 12+
  device-to-device transfer still copies app data unless these rules exclude it.
  ironterm_prefs.xml: EncryptedSharedPreferences with the server URL, app token and Hevy API key.
  __androidx_security_crypto_encrypted_prefs__.xml: its keyset (wrapped by an AndroidKeyStore key).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ironterm_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ironterm_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
